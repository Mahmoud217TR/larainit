#!/usr/bin/env bash
set -e

IMAGE="larainit:latest"

case "${1:-bash}" in
    new)
        shift
        set -- laravel new "$@"
        ;;
    bash)
        shift
        set -- bash "$@"
        ;;
esac

exec docker run --rm -it \
    --user "$(id -u):$(id -g)" \
    -e HOME=/tmp \
    -e COMPOSER_HOME=/tmp/composer \
    -e npm_config_cache=/tmp/npm-cache \
    -v "$PWD:/workspace" \
    -w /workspace \
    "$IMAGE" "$@"
